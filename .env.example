APP_ENV=dev

# Docker ports
HOST_PORT=3000
BASETERM_PORT=3000
BASETERM_API_PORT=4000

# Docker Compose starts a local PostgreSQL database automatically.
# To use an external database instead, provide a URL reachable from Docker:
# COMPOSE_DATABASE_URL=postgresql://user:password@host:5432/baseterm

# Use either Zoho with EMAIL_PASSWORD or SendGrid with EMAIL_PROVIDER_API_KEY.
EMAIL_ADDRESS=
EMAIL_PROVIDER=Zoho
EMAIL_PASSWORD=
EMAIL_PROVIDER_API_KEY=

# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional
BASETERM_ROLLBAR_API_TOKEN=
BASETERM_API_ROLLBAR_API_TOKEN=
MAX_CONNECTION_POOL=20